<Project>

  <PropertyGroup>
    <!-- Every assembly in the solution, not only the one that ships. The app
         reads its own version out of PhotoGallery.Application, because that is
         where the code that asks lives - so a number set on the executable alone
         would be a number the About screen never sees, and the two would agree
         only until the first release that changed one of them.

         The build appends the commit, giving 1.0.0+<sha>: the number is the
         decision, and the commit says which build carried it. -->
    <Version>1.1.0</Version>

    <LangVersion>latest</LangVersion>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <EnforceCodeStyleInBuild>true</EnforceCodeStyleInBuild>
    <GenerateDocumentationFile>false</GenerateDocumentationFile>

    <!-- The csproj files ask for ranges such as 10.*, and a range alone means
         whatever nuget.org has newest on the day of the build - so a release
         could ship a package version nobody ever ran the tests against. Each
         project's packages.lock.json pins what was actually tested, and
         publish.ps1 restores in locked mode, refusing anything else.

         To take newer packages on purpose, run dotnet restore with its
         force-evaluate switch, run the tests, and commit the changed lock
         files. -->
    <RestorePackagesWithLockFile>true</RestorePackagesWithLockFile>
  </PropertyGroup>

  <!-- The app ships as one self-contained file; nothing is installed on the
       target machine. Only the WPF project is published, so these live here
       rather than in every csproj. -->
  <PropertyGroup Condition="'$(MSBuildProjectName)' == 'PhotoGallery.App'">
    <RuntimeIdentifier>win-x64</RuntimeIdentifier>
    <SelfContained>true</SelfContained>
    <PublishSingleFile>true</PublishSingleFile>
    <IncludeNativeLibrariesForSelfExtract>true</IncludeNativeLibrariesForSelfExtract>
    <EnableWindowsTargeting>true</EnableWindowsTargeting>
  </PropertyGroup>

</Project>
