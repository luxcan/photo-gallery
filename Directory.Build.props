<Project>

  <PropertyGroup>
    <!-- Every assembly in the solution, not only the one that ships. The app
         reads its own version out of PhotoGallery.Application, because that is
         where the code that asks lives - so a number set on the executable alone
         would be a number the About screen never sees, and the two would agree
         only until the first release that changed one of them.

         The build appends the commit, giving 1.0.0+<sha>: the number is the
         decision, and the commit says which build carried it. -->
    <Version>1.0.0</Version>

    <LangVersion>latest</LangVersion>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <EnforceCodeStyleInBuild>true</EnforceCodeStyleInBuild>
    <GenerateDocumentationFile>false</GenerateDocumentationFile>
  </PropertyGroup>

  <!-- The app ships as one self-contained file; nothing is installed on the
       target machine. Only the WPF project is published, so these live here
       rather than in every csproj. -->
  <PropertyGroup Condition="'$(MSBuildProjectName)' == 'PhotoGallery.App'">
    <RuntimeIdentifier>win-x64</RuntimeIdentifier>
    <SelfContained>true</SelfContained>
    <PublishSingleFile>true</PublishSingleFile>
    <IncludeNativeLibrariesForSelfExtract>true</IncludeNativeLibrariesForSelfExtract>
    <EnableWindowsTargeting>true</EnableWindowsTargeting>
  </PropertyGroup>

</Project>
