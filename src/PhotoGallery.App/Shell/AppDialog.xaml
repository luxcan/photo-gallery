<Window x:Class="PhotoGallery.App.Shell.AppDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        WindowStyle="None"
        ResizeMode="NoResize"
        ShowInTaskbar="False"
        SizeToContent="Height"
        Width="440"
        WindowStartupLocation="CenterOwner"
        Background="Transparent"
        AllowsTransparency="False"
        KeyDown="OnKeyDown"
        TextOptions.TextFormattingMode="Display">

  <!-- The shared modal surface, so this and the pass overlay are recognisably
       the same object floating over the app. Its own border rather than a
       caption: a dialog this small has nothing to put in a title bar, and
       drawing the surface here is what lets it match the theme, which a
       Windows-drawn message box never could. -->
  <Border Style="{DynamicResource ModalSurface}" MouseLeftButtonDown="OnDrag">
    <Grid>
      <Grid.RowDefinitions>
        <RowDefinition Height="Auto" />
        <RowDefinition Height="Auto" />
        <RowDefinition Height="Auto" />
      </Grid.RowDefinitions>
      <Grid.ColumnDefinitions>
        <ColumnDefinition Width="Auto" />
        <ColumnDefinition Width="*" />
      </Grid.ColumnDefinitions>

      <!-- The glyph carries the tone, so the wording does not have to shout. -->
      <TextBlock x:Name="Glyph" Grid.Row="0" Grid.Column="0"
                 Margin="0,1,12,0" FontSize="17" VerticalAlignment="Top"
                 FontFamily="Segoe MDL2 Assets" />

      <TextBlock x:Name="TitleText" Grid.Row="0" Grid.Column="1"
                 Style="{DynamicResource Heading}" Margin="0"
                 TextWrapping="Wrap" />

      <TextBlock x:Name="MessageText" Grid.Row="1" Grid.Column="1"
                 Style="{DynamicResource BodyText}" Margin="0,8,0,0"
                 TextWrapping="Wrap" />

      <StackPanel x:Name="Buttons" Grid.Row="2" Grid.Column="1"
                  Orientation="Horizontal" HorizontalAlignment="Right"
                  Margin="0,22,0,0" />
    </Grid>
  </Border>
</Window>
