<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                    xmlns:people="clr-namespace:PhotoGallery.App.People"
                    xmlns:shell="clr-namespace:PhotoGallery.App.Shell"
                    xmlns:theme="clr-namespace:PhotoGallery.App.Theme">

  <!-- Colours are DynamicResource throughout so a theme swap re-renders live. -->

  <!-- Segoe UI Variable Text is Windows 11's UI face and what the theme is
       specified in; plain Segoe UI is the fallback and is what Windows 10
       resolves to, so the app reads correctly on both. -->
  <FontFamily x:Key="Font.Ui">Segoe UI Variable Text, Segoe UI</FontFamily>
  <FontFamily x:Key="Font.Mono">Cascadia Mono, Consolas</FontFamily>

  <!--
    One radius vocabulary rather than a number per template, so a later control
    cannot quietly pick a seventh value.

    Inner is not a smaller radius chosen by eye: chrome nested inside other
    chrome stays concentric only when the inner radius is the outer one less the
    padding between them. The segmented toggle is the case in point - a 3px
    track with 2px of padding needs a 1px segment, or the two curves fight.

    Three rather than four because that is the Precision direction's corner, and
    Inner follows it down to keep the relationship above rather than staying at a
    number that was only ever correct against a 4px track.

    Static rather than Dynamic: a corner does not change with the theme.
  -->
  <CornerRadius x:Key="Radius.Control">3</CornerRadius>
  <CornerRadius x:Key="Radius.Inner">1</CornerRadius>

  <!--
    Anything that floats over the app is one of these, so there is one answer to
    what a modal looks like rather than one per place somebody needed one.

    Written as a style on Border rather than a control, because the two users
    want different insides - a dialog holds a question and two buttons, the pass
    overlay holds a live progress bar - and what has to agree is the surface they
    sit on, not their contents.

    Size and placement are deliberately absent. One of these is centred inside
    the window it covers and the other fills a window of its own, so those are
    the caller's to set; putting them here would only mean every caller
    overriding them.
  -->
  <Style x:Key="ModalSurface" TargetType="Border">
    <Setter Property="Background" Value="{DynamicResource Panel.Background}" />
    <Setter Property="BorderBrush" Value="{DynamicResource Panel.Border}" />
    <Setter Property="BorderThickness" Value="1" />
    <Setter Property="CornerRadius" Value="{DynamicResource Radius.Control}" />
    <Setter Property="Padding" Value="24,22,24,18" />
    <Setter Property="SnapsToDevicePixels" Value="True" />
  </Style>

  <!--
    The shade a modal is read against. Deliberately the same in both themes: a
    modal shade is a dimming of what is behind it, and dimming a light screen
    with a light wash would say nothing. It is the one colour here that does not
    come from the palette, and it is defined once so that the two places needing
    it cannot drift.
  -->
  <SolidColorBrush x:Key="ModalScrim" Color="#CC1E1E1E" />

  <!-- Converters live here, beside the template that uses them, so a
       StaticResource lookup resolves within this dictionary. -->
  <BooleanToVisibilityConverter x:Key="BoolToVisibility" />
  <shell:InverseBoolToVisibilityConverter x:Key="InverseBoolToVisibility" />
  <shell:InverseBooleanConverter x:Key="InverseBool" />
  <shell:NullToVisibilityConverter x:Key="NullToVisibility" />
  <shell:InverseNullToVisibilityConverter x:Key="InverseNullToVisibility" />
  <shell:SectionEnabledConverter x:Key="SectionEnabled" />
  <shell:SectionToolTipConverter x:Key="SectionToolTip" />
  <shell:SectionCheckedConverter x:Key="SectionChecked" />
  <shell:SectionCountConverter x:Key="SectionCount" />
  <shell:RemainingWidthConverter x:Key="RemainingWidth" />

  <!-- Table styling. A ListView with a GridView is used rather than hand-built
       rows so the header and the rows share one set of column widths and cannot
       drift apart. -->
  <Style x:Key="TableColumnHeader" TargetType="GridViewColumnHeader">
    <Setter Property="Background" Value="{DynamicResource Neutral.2}" />
    <Setter Property="Foreground" Value="{DynamicResource Editor.Placeholder}" />
    <Setter Property="FontSize" Value="11.5" />
    <Setter Property="FontWeight" Value="SemiBold" />
    <Setter Property="Padding" Value="10,8" />
    <Setter Property="HorizontalContentAlignment" Value="Left" />
    <Setter Property="Template">
      <Setter.Value>
        <ControlTemplate TargetType="GridViewColumnHeader">
          <Border Background="{TemplateBinding Background}"
                  BorderBrush="{DynamicResource Separator}" BorderThickness="0,0,0,1"
                  Padding="{TemplateBinding Padding}">
            <ContentPresenter
              HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}"
              VerticalAlignment="Center" />
          </Border>
        </ControlTemplate>
      </Setter.Value>
    </Setter>
  </Style>

  <!-- For numeric columns, so the heading sits over its figures. -->
  <Style x:Key="TableColumnHeaderRight" TargetType="GridViewColumnHeader"
         BasedOn="{StaticResource TableColumnHeader}">
    <Setter Property="HorizontalContentAlignment" Value="Right" />
  </Style>

  <Style x:Key="TableRow" TargetType="ListViewItem">
    <Setter Property="Padding" Value="10,9" />
    <Setter Property="HorizontalContentAlignment" Value="Stretch" />
    <Setter Property="Foreground" Value="{DynamicResource Editor.Foreground}" />
    <Setter Property="Template">
      <Setter.Value>
        <ControlTemplate TargetType="ListViewItem">
          <Border x:Name="Root" Background="Transparent"
                  BorderBrush="{DynamicResource Separator}" BorderThickness="0,0,0,1"
                  Padding="{TemplateBinding Padding}">
            <GridViewRowPresenter
              Content="{TemplateBinding Content}"
              Columns="{TemplateBinding GridView.ColumnCollection}"
              VerticalAlignment="Center" />
          </Border>
          <ControlTemplate.Triggers>
            <Trigger Property="IsMouseOver" Value="True">
              <Setter TargetName="Root" Property="Background"
                      Value="{DynamicResource List.HoverBackground}" />
            </Trigger>
          </ControlTemplate.Triggers>
        </ControlTemplate>
      </Setter.Value>
    </Setter>
  </Style>

  <Style x:Key="Table" TargetType="ListView">
    <Setter Property="Background" Value="Transparent" />
    <Setter Property="BorderThickness" Value="0" />
    <Setter Property="ItemContainerStyle" Value="{DynamicResource TableRow}" />
    <Setter Property="ScrollViewer.HorizontalScrollBarVisibility" Value="Disabled" />
    <Setter Property="HorizontalContentAlignment" Value="Stretch" />
  </Style>

  <Style x:Key="TableCell" TargetType="TextBlock">
    <Setter Property="FontSize" Value="13" />
    <Setter Property="VerticalAlignment" Value="Center" />
    <Setter Property="Foreground" Value="{DynamicResource Editor.Foreground}" />
  </Style>

  <!-- Shared by the side nav's top and bottom groups, so a section looks and
       behaves the same wherever it sits. Selection goes through a command
       rather than a click handler, because a ResourceDictionary has no
       code-behind to wire events to. -->
  <DataTemplate x:Key="NavigationItem">
    <ToggleButton Style="{DynamicResource NavigationItemButton}"
                  AutomationProperties.Name="{Binding Title}"
                  ToolTipService.ShowOnDisabled="True"
                  Command="{Binding DataContext.SelectSectionCommand,
                            RelativeSource={RelativeSource AncestorType=Window}}"
                  CommandParameter="{Binding}">
      <ToggleButton.Content>
        <Grid>
          <Grid.ColumnDefinitions>
            <ColumnDefinition Width="Auto" />
            <ColumnDefinition Width="*" />
            <ColumnDefinition Width="Auto" />
          </Grid.ColumnDefinitions>

          <!-- A fixed cell, first in the row. Everything that changes between
               the two widths is to its right, so the icon cannot be pushed
               about mid-animation: nothing upstream of it in the layout moves,
               and the star column simply absorbs whatever the pane has left on
               each frame. That, rather than a pair of per-state paddings tuned
               to agree, is what holds it still.

               The icon font is on this TextBlock alone. On the button it would
               inherit onto the name and the count, and Segoe MDL2 Assets has no
               letters or digits at all, so both would fall silently through to
               WPF's font fallback. -->
          <TextBlock Grid.Column="0" Width="14" Text="{Binding Glyph}"
                     FontFamily="Segoe MDL2 Assets" FontSize="14"
                     TextAlignment="Center" VerticalAlignment="Center" />

          <!-- Collapsed, never Hidden, and never faded: a faded name still holds
               its width open. Driven by the window rather than by the view
               model's fold, because the two change at different moments - the
               names leave as a fold begins, and come back only once the pane has
               finished opening, or they would re-trim their own ellipsis for the
               whole 180ms on the way out. -->
          <TextBlock Grid.Column="1" Margin="10,0,0,0" Text="{Binding Title}"
                     FontFamily="{StaticResource Font.Ui}" FontSize="13"
                     VerticalAlignment="Center" TextTrimming="CharacterEllipsis"
                     Visibility="{Binding NavLabelsVisible,
                                  RelativeSource={RelativeSource AncestorType=Window},
                                  Converter={StaticResource BoolToVisibility}}" />

          <TextBlock Grid.Column="2" Margin="8,0,0,0" FontSize="11"
                     FontFamily="{StaticResource Font.Ui}"
                     VerticalAlignment="Center"
                     Foreground="{DynamicResource TextDisabled}"
                     Visibility="{Binding NavLabelsVisible,
                                  RelativeSource={RelativeSource AncestorType=Window},
                                  Converter={StaticResource BoolToVisibility}}">
            <TextBlock.Text>
              <MultiBinding Converter="{StaticResource SectionCount}">
                <Binding Path="Key" />
                <Binding Path="DataContext.Counts"
                         RelativeSource="{RelativeSource AncestorType=Window}" />
                <Binding Path="DataContext.Sources.Count"
                         RelativeSource="{RelativeSource AncestorType=Window}" />
              </MultiBinding>
            </TextBlock.Text>
          </TextBlock>
        </Grid>
      </ToggleButton.Content>
      <ToggleButton.IsChecked>
        <MultiBinding Converter="{StaticResource SectionChecked}" Mode="OneWay">
          <Binding />
          <Binding Path="DataContext.SelectedSection"
                   RelativeSource="{RelativeSource AncestorType=Window}" />
        </MultiBinding>
      </ToggleButton.IsChecked>
      <ToggleButton.IsEnabled>
        <MultiBinding Converter="{StaticResource SectionEnabled}">
          <Binding Path="RequiresSources" />
          <Binding Path="DataContext.HasSources"
                   RelativeSource="{RelativeSource AncestorType=Window}" />
        </MultiBinding>
      </ToggleButton.IsEnabled>
      <!-- One tooltip, not two. Folded, the icon is not a label and every item
           needs its name; open, only a disabled item has anything left to say -
           and it has to say it either way, because it is the reason the item
           will not respond. The name TextBlock deliberately has no tooltip of
           its own: WPF resolves the tooltip on the innermost element under the
           pointer, so one there would hide this exactly where the pointer
           lands. -->
      <ToggleButton.ToolTip>
        <MultiBinding Converter="{StaticResource SectionToolTip}">
          <Binding Path="Title" />
          <Binding Path="RequiresSources" />
          <Binding Path="DataContext.HasSources"
                   RelativeSource="{RelativeSource AncestorType=Window}" />
          <Binding Path="DataContext.IsNavCollapsed"
                   RelativeSource="{RelativeSource AncestorType=Window}" />
        </MultiBinding>
      </ToggleButton.ToolTip>
    </ToggleButton>
  </DataTemplate>

  <!--
    32 high in both states, and every horizontal measurement in it is
    state-independent: the rail is overlaid rather than laid out, so it costs the
    content no width, and the presenter's 7 puts the icon's left edge 19 DIP from
    the pane's edge whether the names are there or not. Centre 26, which is half
    of the 52 the pane folds to.

    Foreground is set once on the button and inherits down to the glyph and the
    name, so a state trigger only has to touch one property.
  -->
  <Style x:Key="NavigationItemButton" TargetType="ToggleButton">
    <Setter Property="Height" Value="32" />
    <Setter Property="Margin" Value="0,0,0,2" />
    <!-- Stretch, or the default Center shrink-wraps the row and the star column
         - and with it the name - collapses to nothing. -->
    <Setter Property="HorizontalAlignment" Value="Stretch" />
    <Setter Property="Foreground" Value="{DynamicResource SideNav.Foreground}" />
    <Setter Property="Background" Value="Transparent" />
    <Setter Property="Cursor" Value="Hand" />
    <Setter Property="SnapsToDevicePixels" Value="True" />
    <Setter Property="Template">
      <Setter.Value>
        <ControlTemplate TargetType="ToggleButton">
          <Grid>
            <Border x:Name="Fill" Background="{TemplateBinding Background}"
                    CornerRadius="{StaticResource Radius.Control}" />
            <!-- Rounded on its left pair only, or a square 2 DIP strip hangs off
                 the corners of a 3 DIP pill. A Border does not clip its child to
                 a corner radius, so nesting the rail inside the fill does not
                 solve it. -->
            <Border x:Name="Indicator" Width="2" HorizontalAlignment="Left"
                    CornerRadius="3,0,0,3" Background="Transparent" />
            <ContentPresenter Margin="7,0" VerticalAlignment="Center"
                              HorizontalAlignment="Stretch" />
          </Grid>
          <ControlTemplate.Triggers>
            <!-- Guarded on IsEnabled, because WPF raises IsMouseOver on a
                 disabled element too - that is what makes ShowOnDisabled work -
                 and a greyed section that lights up reads as clickable and then
                 refuses the click. The foreground moves as well as the fill: in
                 the light palette the hover wash is two per cent off the nav's
                 own background, so on its own it says almost nothing. -->
            <MultiTrigger>
              <MultiTrigger.Conditions>
                <Condition Property="IsMouseOver" Value="True" />
                <Condition Property="IsEnabled" Value="True" />
              </MultiTrigger.Conditions>
              <Setter TargetName="Fill" Property="Background"
                      Value="{DynamicResource List.HoverBackground}" />
              <Setter Property="Foreground"
                      Value="{DynamicResource SideNav.ActiveForeground}" />
            </MultiTrigger>
            <!-- After the hover trigger, so hovering the selected item does not
                 replace its selection fill with the hover one. -->
            <Trigger Property="IsChecked" Value="True">
              <Setter TargetName="Fill" Property="Background"
                      Value="{DynamicResource List.ActiveSelection}" />
              <Setter TargetName="Indicator" Property="Background"
                      Value="{DynamicResource SideNav.ActiveBorder}" />
              <Setter Property="Foreground"
                      Value="{DynamicResource SideNav.ActiveForeground}" />
            </Trigger>
            <Trigger Property="IsKeyboardFocused" Value="True">
              <Setter TargetName="Indicator" Property="Background"
                      Value="{DynamicResource Focus.Border}" />
            </Trigger>
            <!-- Last, so the disabled colour beats selection and hover both. -->
            <Trigger Property="IsEnabled" Value="False">
              <Setter Property="Foreground" Value="{DynamicResource TextDisabled}" />
              <Setter Property="Cursor" Value="Arrow" />
            </Trigger>
          </ControlTemplate.Triggers>
        </ControlTemplate>
      </Setter.Value>
    </Setter>
  </Style>

  <!-- E76B and E76C are ChevronLeft and ChevronRight in Segoe MDL2 Assets, the
       same face the section glyphs use, so nothing else in the nav is redrawn.
       The tooltip names the act rather than the state, so a screen reader hears
       what clicking will do.

       Radius.Control rather than the handoff's 2: this file carries a standing
       rule against a seventh radius, and 3 on a 26 DIP square is not tellable
       from 2. -->
  <Style x:Key="NavigationChevron" TargetType="Button">
    <Setter Property="Width" Value="26" />
    <Setter Property="Height" Value="26" />
    <Setter Property="Foreground" Value="{DynamicResource SideNav.Foreground}" />
    <Setter Property="Background" Value="Transparent" />
    <Setter Property="Cursor" Value="Hand" />
    <Setter Property="FontFamily" Value="Segoe MDL2 Assets" />
    <Setter Property="FontSize" Value="11" />
    <Setter Property="Content" Value="&#xE76B;" />
    <Setter Property="ToolTip" Value="Hide the section names" />
    <Setter Property="AutomationProperties.Name" Value="Hide the section names" />
    <Setter Property="Template">
      <Setter.Value>
        <ControlTemplate TargetType="Button">
          <Border x:Name="Fill" Background="{TemplateBinding Background}"
                  CornerRadius="{StaticResource Radius.Control}">
            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
          </Border>
          <ControlTemplate.Triggers>
            <Trigger Property="IsMouseOver" Value="True">
              <Setter TargetName="Fill" Property="Background"
                      Value="{DynamicResource List.HoverBackground}" />
              <Setter Property="Foreground"
                      Value="{DynamicResource SideNav.ActiveForeground}" />
            </Trigger>
            <Trigger Property="IsKeyboardFocused" Value="True">
              <Setter TargetName="Fill" Property="Background"
                      Value="{DynamicResource List.HoverBackground}" />
              <Setter Property="Foreground"
                      Value="{DynamicResource SideNav.ActiveForeground}" />
            </Trigger>
          </ControlTemplate.Triggers>
        </ControlTemplate>
      </Setter.Value>
    </Setter>
    <Style.Triggers>
      <DataTrigger Binding="{Binding IsNavCollapsed}" Value="True">
        <Setter Property="Content" Value="&#xE76C;" />
        <Setter Property="ToolTip" Value="Show the section names" />
        <Setter Property="AutomationProperties.Name" Value="Show the section names" />
      </DataTrigger>
    </Style.Triggers>
  </Style>

  <Style x:Key="ListItem" TargetType="ListBoxItem">
    <Setter Property="Foreground" Value="{DynamicResource SideBar.Foreground}" />
    <Setter Property="Padding" Value="16,4" />
    <Setter Property="FontSize" Value="13" />
    <Setter Property="Template">
      <Setter.Value>
        <ControlTemplate TargetType="ListBoxItem">
          <Border x:Name="Root" Background="Transparent" Padding="{TemplateBinding Padding}"
                  CornerRadius="{StaticResource Radius.Control}">
            <ContentPresenter />
          </Border>
          <ControlTemplate.Triggers>
            <Trigger Property="IsMouseOver" Value="True">
              <Setter TargetName="Root" Property="Background"
                      Value="{DynamicResource List.HoverBackground}" />
            </Trigger>
            <Trigger Property="IsSelected" Value="True">
              <Setter TargetName="Root" Property="Background"
                      Value="{DynamicResource List.ActiveSelection}" />
              <Setter Property="Foreground" Value="{DynamicResource List.ActiveSelectionText}" />
            </Trigger>
            <Trigger Property="IsKeyboardFocusWithin" Value="True">
              <Setter TargetName="Root" Property="BorderBrush"
                      Value="{DynamicResource Focus.Border}" />
              <Setter TargetName="Root" Property="BorderThickness" Value="1" />
            </Trigger>
          </ControlTemplate.Triggers>
        </ControlTemplate>
      </Setter.Value>
    </Setter>
  </Style>

  <Style x:Key="PrimaryButton" TargetType="Button">
    <Setter Property="Background" Value="{DynamicResource Button.Background}" />
    <Setter Property="Foreground" Value="{DynamicResource Button.Foreground}" />

    <!-- Its own states, carried on the button, so the one template below can
         serve a style whose states are different without a second copy of it. -->
    <Setter Property="theme:ButtonStates.HoverBackground"
            Value="{DynamicResource Button.HoverBackground}" />
    <Setter Property="theme:ButtonStates.PressedBackground"
            Value="{DynamicResource Button.PressedBackground}" />

    <!-- The accent button's outline is its own fill, as the theme specifies, so
         it reads as a solid block rather than a bordered one - but the border is
         drawn all the same, because a button that grows one only when focused
         moves its label a pixel as it arrives. -->
    <Setter Property="BorderBrush" Value="{DynamicResource Button.Background}" />
    <Setter Property="theme:ButtonStates.HoverBorder"
            Value="{DynamicResource Button.HoverBackground}" />
    <Setter Property="BorderThickness" Value="1" />

    <Setter Property="FontSize" Value="13" />
    <Setter Property="Padding" Value="15,6" />
    <Setter Property="Cursor" Value="Hand" />
    <Setter Property="Template">
      <Setter.Value>
        <ControlTemplate TargetType="Button">
          <Border x:Name="Root" Background="{TemplateBinding Background}"
                  BorderBrush="{TemplateBinding BorderBrush}"
                  BorderThickness="{TemplateBinding BorderThickness}"
                  Padding="{TemplateBinding Padding}"
                  CornerRadius="{StaticResource Radius.Control}"
                  SnapsToDevicePixels="True">
            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
          </Border>
          <ControlTemplate.Triggers>
            <!-- Read off the button rather than named here, so a style that
                 changes its Background changes its hover with it. -->
            <Trigger Property="IsMouseOver" Value="True">
              <Setter TargetName="Root" Property="Background"
                      Value="{Binding RelativeSource={RelativeSource TemplatedParent},
                                      Path=(theme:ButtonStates.HoverBackground)}" />
              <Setter TargetName="Root" Property="BorderBrush"
                      Value="{Binding RelativeSource={RelativeSource TemplatedParent},
                                      Path=(theme:ButtonStates.HoverBorder)}" />
            </Trigger>
            <Trigger Property="IsPressed" Value="True">
              <Setter TargetName="Root" Property="Background"
                      Value="{Binding RelativeSource={RelativeSource TemplatedParent},
                                      Path=(theme:ButtonStates.PressedBackground)}" />
            </Trigger>
            <Trigger Property="IsKeyboardFocused" Value="True">
              <Setter TargetName="Root" Property="BorderBrush"
                      Value="{DynamicResource Focus.Border}" />
            </Trigger>
            <Trigger Property="IsEnabled" Value="False">
              <Setter TargetName="Root" Property="Opacity" Value="0.5" />
            </Trigger>
          </ControlTemplate.Triggers>
        </ControlTemplate>
      </Setter.Value>
    </Setter>
  </Style>

  <Style x:Key="SecondaryButton" TargetType="Button" BasedOn="{StaticResource PrimaryButton}">
    <Setter Property="Background" Value="{DynamicResource Button.SecondaryBackground}" />
    <Setter Property="Foreground" Value="{DynamicResource SideBar.Foreground}" />

    <!-- Its own hover and pressed, which is the whole point of the two
         properties: without them this inherited the primary button's accent and
         a quiet grey button lit up teal under the pointer. -->
    <Setter Property="theme:ButtonStates.HoverBackground"
            Value="{DynamicResource Button.SecondaryHover}" />
    <Setter Property="theme:ButtonStates.PressedBackground"
            Value="{DynamicResource Button.SecondaryPressedBackground}" />

    <!-- The outline the theme has always specified for a standard button, and
         which this style did not draw. Its fill is ControlBackground and so is
         the surface most of these sit on, so without the border the button had
         no edge at all until the pointer was over it - invisible on the About
         card, and nearly so beside a text box. -->
    <Setter Property="BorderBrush" Value="{DynamicResource Input.Border}" />
    <Setter Property="theme:ButtonStates.HoverBorder"
            Value="{DynamicResource ControlBorderHover}" />
  </Style>

  <!--
    One segment of a two-way picker. Still a RadioButton rather than a
    ToggleButton, so the pair stays mutually exclusive on its own, keeps arrow-key
    navigation, and reads to a screen reader as one choice rather than two
    unrelated switches - only the dot and label are replaced.

    The checked trigger sits after the hover one deliberately: later triggers win,
    so the selected segment keeps its accent instead of greying under the pointer.
  -->
  <Style x:Key="SegmentedToggle" TargetType="RadioButton">
    <Setter Property="Foreground" Value="{DynamicResource Editor.Foreground}" />
    <Setter Property="Background" Value="Transparent" />
    <Setter Property="FontSize" Value="12" />
    <Setter Property="Padding" Value="14,5" />
    <Setter Property="Cursor" Value="Hand" />
    <Setter Property="Template">
      <Setter.Value>
        <ControlTemplate TargetType="RadioButton">
          <Border x:Name="Root" Background="{TemplateBinding Background}"
                  Padding="{TemplateBinding Padding}"
                  CornerRadius="{StaticResource Radius.Inner}"
                  SnapsToDevicePixels="True">
            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
          </Border>
          <ControlTemplate.Triggers>
            <Trigger Property="IsMouseOver" Value="True">
              <Setter TargetName="Root" Property="Background"
                      Value="{DynamicResource Button.SecondaryHover}" />
            </Trigger>
            <Trigger Property="IsChecked" Value="True">
              <Setter TargetName="Root" Property="Background"
                      Value="{DynamicResource Button.Background}" />
              <Setter Property="Foreground" Value="{DynamicResource Button.Foreground}" />
            </Trigger>
            <Trigger Property="IsKeyboardFocused" Value="True">
              <Setter TargetName="Root" Property="BorderBrush"
                      Value="{DynamicResource Focus.Border}" />
              <Setter TargetName="Root" Property="BorderThickness" Value="1" />
            </Trigger>
          </ControlTemplate.Triggers>
        </ControlTemplate>
      </Setter.Value>
    </Setter>
  </Style>

  <Style x:Key="LinkButton" TargetType="Button">
    <Setter Property="Foreground" Value="{DynamicResource Link.Foreground}" />
    <Setter Property="Background" Value="Transparent" />
    <Setter Property="Cursor" Value="Hand" />
    <Setter Property="FontSize" Value="13" />
    <Setter Property="HorizontalContentAlignment" Value="Left" />
    <Setter Property="Padding" Value="0,2" />
    <Setter Property="Template">
      <Setter.Value>
        <ControlTemplate TargetType="Button">
          <!-- The ring is drawn transparent at rest rather than added on focus,
               so arriving by keyboard colours a border that is already there and
               the text does not shift a pixel sideways as it appears. -->
          <Border x:Name="Root" Background="Transparent" Margin="-1,0"
                  BorderBrush="Transparent" BorderThickness="1"
                  CornerRadius="{StaticResource Radius.Inner}"
                  Padding="{TemplateBinding Padding}">
            <ContentPresenter HorizontalAlignment="Left" />
          </Border>
          <ControlTemplate.Triggers>
            <Trigger Property="IsMouseOver" Value="True">
              <Setter Property="TextBlock.TextDecorations" Value="Underline" />
            </Trigger>
            <!-- A link has no fill and no outline to change, so without this it
                 was the one control in the app a keyboard could reach and not
                 show it had reached. -->
            <Trigger Property="IsKeyboardFocused" Value="True">
              <Setter Property="TextBlock.TextDecorations" Value="Underline" />
              <Setter TargetName="Root" Property="BorderBrush"
                      Value="{DynamicResource Focus.Border}" />
            </Trigger>
          </ControlTemplate.Triggers>
        </ControlTemplate>
      </Setter.Value>
    </Setter>
  </Style>

  <!-- The app's first progress bar. Stock WPF chrome is Aero-flavoured and would
       not sit beside these flat buttons, so it is templated like everything else
       here. PART_Track and PART_Indicator are both required: ProgressBar sizes the
       indicator against the track and draws nothing if either is missing. The
       colours are the existing neutral ramp and the same blue as the status text
       beside it, so no new theme keys are needed. -->
  <Style x:Key="PassProgress" TargetType="ProgressBar">
    <Setter Property="Height" Value="6" />
    <Setter Property="Focusable" Value="False" />
    <Setter Property="Background" Value="{DynamicResource Neutral.3}" />
    <Setter Property="Foreground" Value="{DynamicResource Status.Info}" />
    <Setter Property="Template">
      <Setter.Value>
        <ControlTemplate TargetType="ProgressBar">
          <Border Background="{TemplateBinding Background}" SnapsToDevicePixels="True"
                  ClipToBounds="True">
            <Grid>
              <Rectangle x:Name="PART_Track" />
              <Rectangle x:Name="PART_Indicator" HorizontalAlignment="Left"
                         Fill="{TemplateBinding Foreground}" />
              <!-- Shown only while there is no total to fill towards, which is the
                   whole of a crawl: it cannot know how many files it will find
                   until it has found them. -->
              <Rectangle x:Name="Runner" Width="90" Visibility="Collapsed"
                         HorizontalAlignment="Left" Fill="{TemplateBinding Foreground}">
                <Rectangle.RenderTransform>
                  <TranslateTransform x:Name="RunnerShift" />
                </Rectangle.RenderTransform>
              </Rectangle>
            </Grid>
          </Border>
          <ControlTemplate.Triggers>
            <Trigger Property="IsIndeterminate" Value="True">
              <Setter TargetName="PART_Indicator" Property="Visibility" Value="Collapsed" />
              <Setter TargetName="Runner" Property="Visibility" Value="Visible" />
              <Trigger.EnterActions>
                <BeginStoryboard x:Name="Sliding">
                  <!-- Travels further than any bar here is wide and is clipped, so
                       it leaves cleanly whatever the card's width turns out to be. -->
                  <Storyboard RepeatBehavior="Forever">
                    <DoubleAnimation Storyboard.TargetName="RunnerShift"
                                     Storyboard.TargetProperty="X"
                                     From="-90" To="560" Duration="0:0:1.4" />
                  </Storyboard>
                </BeginStoryboard>
              </Trigger.EnterActions>
              <Trigger.ExitActions>
                <StopStoryboard BeginStoryboardName="Sliding" />
              </Trigger.ExitActions>
            </Trigger>
          </ControlTemplate.Triggers>
        </ControlTemplate>
      </Setter.Value>
    </Setter>
  </Style>

  <!-- Set-up screen typography -->
  <Style x:Key="Eyebrow" TargetType="TextBlock">
    <Setter Property="FontSize" Value="11" />
    <Setter Property="FontWeight" Value="SemiBold" />
    <Setter Property="Foreground" Value="{DynamicResource Editor.Placeholder}" />
    <Setter Property="Margin" Value="0,0,0,10" />
  </Style>

  <Style x:Key="Heading" TargetType="TextBlock">
    <Setter Property="FontSize" Value="28" />
    <Setter Property="FontWeight" Value="Bold" />
    <Setter Property="Foreground" Value="{DynamicResource Editor.Foreground}" />
    <Setter Property="Margin" Value="0,0,0,12" />
  </Style>

  <Style x:Key="BodyText" TargetType="TextBlock">
    <Setter Property="FontSize" Value="13.5" />
    <Setter Property="LineHeight" Value="21" />
    <Setter Property="TextWrapping" Value="Wrap" />
    <Setter Property="Foreground" Value="{DynamicResource Editor.Placeholder}" />
  </Style>

  <Style x:Key="FieldLabel" TargetType="TextBlock">
    <Setter Property="FontSize" Value="12.5" />
    <Setter Property="FontWeight" Value="SemiBold" />
    <Setter Property="Foreground" Value="{DynamicResource Editor.Foreground}" />
    <Setter Property="Margin" Value="0,0,0,6" />
  </Style>

  <Style x:Key="HintText" TargetType="TextBlock">
    <Setter Property="FontSize" Value="12" />
    <Setter Property="TextWrapping" Value="Wrap" />
    <Setter Property="Foreground" Value="{DynamicResource Editor.Placeholder}" />
    <Setter Property="Margin" Value="0,7,0,0" />
  </Style>

  <Style x:Key="InputTextBox" TargetType="TextBox">
    <Setter Property="Background" Value="{DynamicResource Input.Background}" />
    <Setter Property="Foreground" Value="{DynamicResource Input.Foreground}" />
    <Setter Property="BorderBrush" Value="{DynamicResource Input.Border}" />
    <Setter Property="BorderThickness" Value="1" />
    <Setter Property="Padding" Value="10,7" />
    <Setter Property="FontSize" Value="13" />
    <Setter Property="VerticalContentAlignment" Value="Center" />
    <Setter Property="Template">
      <Setter.Value>
        <ControlTemplate TargetType="TextBox">
          <Border x:Name="Root" Background="{TemplateBinding Background}"
                  BorderBrush="{TemplateBinding BorderBrush}"
                  BorderThickness="{TemplateBinding BorderThickness}"
                  CornerRadius="{StaticResource Radius.Control}"
                  SnapsToDevicePixels="True">
            <ScrollViewer x:Name="PART_ContentHost"
                          Margin="{TemplateBinding Padding}"
                          VerticalAlignment="Center" />
          </Border>
          <ControlTemplate.Triggers>
            <Trigger Property="IsKeyboardFocusWithin" Value="True">
              <Setter TargetName="Root" Property="BorderBrush"
                      Value="{DynamicResource Focus.Border}" />
              <Setter TargetName="Root" Property="BorderThickness" Value="2" />
            </Trigger>
          </ControlTemplate.Triggers>
        </ControlTemplate>
      </Setter.Value>
    </Setter>
  </Style>

  <Style x:Key="StatusBarText" TargetType="TextBlock">
    <Setter Property="Foreground" Value="{DynamicResource StatusBar.Foreground}" />
    <Setter Property="FontSize" Value="12" />
    <Setter Property="VerticalAlignment" Value="Center" />
    <Setter Property="Margin" Value="0,0,16,0" />
  </Style>

  <!-- Gallery. A row of pictures is the list's item, so the stock virtualising
       stack panel can recycle rows; a wrap panel of 11,482 pictures realises
       every one of them and costs 90 MB of visual tree. Every row must be the
       same height, so the sizes come from GalleryLayout rather than being
       repeated here. -->
  <Style x:Key="GalleryRowItem" TargetType="ListBoxItem">
    <Setter Property="Padding" Value="0" />
    <Setter Property="Margin" Value="0" />
    <Setter Property="HorizontalContentAlignment" Value="Stretch" />
    <Setter Property="Template">
      <Setter.Value>
        <ControlTemplate TargetType="ListBoxItem">
          <ContentPresenter />
        </ControlTemplate>
      </Setter.Value>
    </Setter>
  </Style>

  <Style x:Key="GalleryList" TargetType="ListBox">
    <Setter Property="Background" Value="Transparent" />
    <Setter Property="BorderThickness" Value="0" />
    <Setter Property="Focusable" Value="False" />
    <Setter Property="ItemContainerStyle" Value="{DynamicResource GalleryRowItem}" />
    <Setter Property="ScrollViewer.HorizontalScrollBarVisibility" Value="Disabled" />
    <Setter Property="ScrollViewer.VerticalScrollBarVisibility" Value="Auto" />
    <!-- Recycling reuses containers instead of rebuilding them; pixel scrolling
         stops the wheel jumping a whole row at a time. The cache length already
         defaults to one viewport either side, so it is left alone. -->
    <Setter Property="VirtualizingPanel.IsVirtualizing" Value="True" />
    <Setter Property="VirtualizingPanel.VirtualizationMode" Value="Recycling" />
    <Setter Property="VirtualizingPanel.ScrollUnit" Value="Pixel" />
  </Style>

  <Style x:Key="GalleryCell" TargetType="Button">
    <Setter Property="Background" Value="{DynamicResource Neutral.3}" />
    <Setter Property="Cursor" Value="Hand" />
    <Setter Property="Template">
      <Setter.Value>
        <ControlTemplate TargetType="Button">
          <Border x:Name="Root" Background="{TemplateBinding Background}"
                  SnapsToDevicePixels="True">
            <Grid ClipToBounds="True">
              <!-- Drawn under the picture, so a cell that has nothing to show
                   yet keeps the grid's geometry instead of leaving a hole. -->
              <TextBlock Text="&#xEB9F;" FontFamily="Segoe MDL2 Assets" FontSize="26"
                         HorizontalAlignment="Center" VerticalAlignment="Center"
                         Foreground="{DynamicResource Editor.Placeholder}" />
              <ContentPresenter />
              <Border x:Name="Focus" BorderBrush="{DynamicResource Focus.Border}"
                      BorderThickness="0" />
            </Grid>
          </Border>
          <ControlTemplate.Triggers>
            <Trigger Property="IsMouseOver" Value="True">
              <Setter TargetName="Focus" Property="BorderThickness" Value="2" />
            </Trigger>
            <Trigger Property="IsKeyboardFocused" Value="True">
              <Setter TargetName="Focus" Property="BorderThickness" Value="2" />
            </Trigger>
          </ControlTemplate.Triggers>
        </ControlTemplate>
      </Setter.Value>
    </Setter>
  </Style>

  <Style x:Key="VideoBadge" TargetType="Border">
    <Setter Property="Background" Value="{DynamicResource Badge.Background}" />
    <Setter Property="HorizontalAlignment" Value="Right" />
    <Setter Property="VerticalAlignment" Value="Bottom" />
    <Setter Property="Margin" Value="0,0,6,6" />
    <Setter Property="Padding" Value="5,2" />
  </Style>

  <Style x:Key="ViewerButton" TargetType="Button" BasedOn="{StaticResource SecondaryButton}">
    <Setter Property="FontFamily" Value="Segoe MDL2 Assets" />
    <Setter Property="FontSize" Value="16" />
    <Setter Property="Padding" Value="14,10" />
    <Setter Property="MinWidth" Value="48" />
  </Style>

  <!-- Folder tree. Stock TreeView draws its own selection in system colours,
       which reads as a foreign control inside this shell, and its expander is a
       hairline triangle. Both are replaced. -->
  <Style x:Key="FolderExpander" TargetType="ToggleButton">
    <Setter Property="Width" Value="16" />
    <Setter Property="Height" Value="16" />
    <Setter Property="Focusable" Value="False" />
    <Setter Property="Foreground" Value="{DynamicResource Editor.Placeholder}" />
    <Setter Property="Template">
      <Setter.Value>
        <ControlTemplate TargetType="ToggleButton">
          <Border Background="Transparent">
            <TextBlock x:Name="Glyph" Text="&#xE76C;" FontFamily="Segoe MDL2 Assets"
                       FontSize="9" HorizontalAlignment="Center" VerticalAlignment="Center"
                       Foreground="{TemplateBinding Foreground}" />
          </Border>
          <ControlTemplate.Triggers>
            <Trigger Property="IsChecked" Value="True">
              <Setter TargetName="Glyph" Property="Text" Value="&#xE70D;" />
            </Trigger>
            <Trigger Property="IsMouseOver" Value="True">
              <Setter TargetName="Glyph" Property="Foreground"
                      Value="{DynamicResource Editor.Foreground}" />
            </Trigger>
          </ControlTemplate.Triggers>
        </ControlTemplate>
      </Setter.Value>
    </Setter>
  </Style>

  <Style x:Key="FolderTreeItem" TargetType="TreeViewItem">
    <Setter Property="Foreground" Value="{DynamicResource Editor.Foreground}" />
    <Setter Property="HorizontalContentAlignment" Value="Stretch" />
    <Setter Property="IsExpanded" Value="False" />
    <Setter Property="Template">
      <Setter.Value>
        <ControlTemplate TargetType="TreeViewItem">
          <StackPanel>
            <!-- A hairline under each row, so a dense tree stays readable. -->
            <Border x:Name="Row" Background="Transparent" Padding="0,5"
                    BorderBrush="{DynamicResource Separator}" BorderThickness="0,0,0,1">
              <Grid>
                <Grid.ColumnDefinitions>
                  <ColumnDefinition Width="18" />
                  <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>
                <ToggleButton Grid.Column="0" Style="{DynamicResource FolderExpander}"
                              ClickMode="Press"
                              IsChecked="{Binding IsExpanded,
                                          RelativeSource={RelativeSource TemplatedParent}}"
                              Visibility="{TemplateBinding HasItems,
                                           Converter={StaticResource BoolToVisibility}}" />
                <ContentPresenter Grid.Column="1" ContentSource="Header"
                                  VerticalAlignment="Center" />
              </Grid>
            </Border>
            <ItemsPresenter x:Name="Children" Margin="14,0,0,0" />
          </StackPanel>
          <ControlTemplate.Triggers>
            <Trigger Property="IsExpanded" Value="False">
              <Setter TargetName="Children" Property="Visibility" Value="Collapsed" />
            </Trigger>
            <Trigger Property="IsMouseOver" Value="True">
              <Setter TargetName="Row" Property="Background"
                      Value="{DynamicResource List.HoverBackground}" />
            </Trigger>
            <Trigger Property="IsSelected" Value="True">
              <Setter TargetName="Row" Property="Background"
                      Value="{DynamicResource List.ActiveSelection}" />
              <Setter Property="Foreground"
                      Value="{DynamicResource List.ActiveSelectionText}" />
            </Trigger>
          </ControlTemplate.Triggers>
        </ControlTemplate>
      </Setter.Value>
    </Setter>
  </Style>

  <Style x:Key="FolderTree" TargetType="TreeView">
    <Setter Property="Background" Value="Transparent" />
    <Setter Property="BorderThickness" Value="0" />
    <Setter Property="Foreground" Value="{DynamicResource Editor.Foreground}" />
    <Setter Property="ItemContainerStyle" Value="{DynamicResource FolderTreeItem}" />
    <Setter Property="ScrollViewer.HorizontalScrollBarVisibility" Value="Disabled" />
    <Setter Property="VirtualizingPanel.IsVirtualizing" Value="True" />
    <Setter Property="VirtualizingPanel.VirtualizationMode" Value="Recycling" />
  </Style>

  <!-- One name offered by the search box. A Button rather than a list item
       because picking it is an action, not a selection that persists. -->
  <Style x:Key="SearchResult" TargetType="Button">
    <Setter Property="Background" Value="Transparent" />
    <Setter Property="BorderThickness" Value="0" />
    <Setter Property="Foreground" Value="{DynamicResource SideBar.Foreground}" />
    <Setter Property="Padding" Value="16,7" />
    <Setter Property="Cursor" Value="Hand" />
    <Setter Property="HorizontalContentAlignment" Value="Stretch" />
    <Setter Property="Template">
      <Setter.Value>
        <ControlTemplate TargetType="Button">
          <Border x:Name="Face" Background="{TemplateBinding Background}"
                  Padding="{TemplateBinding Padding}" SnapsToDevicePixels="True">
            <ContentPresenter HorizontalAlignment="Stretch" />
          </Border>
          <ControlTemplate.Triggers>
            <Trigger Property="IsMouseOver" Value="True">
              <Setter TargetName="Face" Property="Background"
                      Value="{DynamicResource List.HoverBackground}" />
            </Trigger>
            <Trigger Property="IsKeyboardFocused" Value="True">
              <Setter TargetName="Face" Property="Background"
                      Value="{DynamicResource List.HoverBackground}" />
            </Trigger>
          </ControlTemplate.Triggers>
        </ControlTemplate>
      </Setter.Value>
    </Setter>
  </Style>

  <!-- An on/off switch, the shape a phone uses. A button labelled with the
       action it performs has to be read before its state is known; a switch
       shows the state and needs no label at all. Neutral.6 reads as "off" in
       both palettes, and the accent as "on". -->
  <Style x:Key="Switch" TargetType="ToggleButton">
    <Setter Property="Cursor" Value="Hand" />
    <Setter Property="Width" Value="38" />
    <Setter Property="Height" Value="22" />
    <Setter Property="HorizontalAlignment" Value="Left" />
    <Setter Property="Template">
      <Setter.Value>
        <ControlTemplate TargetType="ToggleButton">
          <Border x:Name="Track" CornerRadius="11" SnapsToDevicePixels="True"
                  Background="{DynamicResource Neutral.6}">
            <Border x:Name="Knob" Width="16" Height="16" CornerRadius="8" Margin="3,0,0,0"
                    HorizontalAlignment="Left" VerticalAlignment="Center"
                    Background="{DynamicResource Button.Foreground}" />
          </Border>
          <ControlTemplate.Triggers>
            <Trigger Property="IsChecked" Value="True">
              <Setter TargetName="Track" Property="Background"
                      Value="{DynamicResource Button.Background}" />
              <Setter TargetName="Knob" Property="HorizontalAlignment" Value="Right" />
              <Setter TargetName="Knob" Property="Margin" Value="0,0,3,0" />
            </Trigger>
            <Trigger Property="IsMouseOver" Value="True">
              <Setter TargetName="Track" Property="Opacity" Value="0.85" />
            </Trigger>
            <Trigger Property="IsKeyboardFocused" Value="True">
              <Setter TargetName="Track" Property="BorderThickness" Value="2" />
              <Setter TargetName="Track" Property="BorderBrush"
                      Value="{DynamicResource Focus.Border}" />
            </Trigger>
          </ControlTemplate.Triggers>
        </ControlTemplate>
      </Setter.Value>
    </Setter>
  </Style>

  <!-- A standalone on/off button. Not SegmentedToggle, which is a RadioButton
       style and belongs to a group of mutually exclusive choices - applying it
       to a ToggleButton throws while the window is being parsed, which takes the
       whole app down before it has drawn anything. -->
  <Style x:Key="PillToggle" TargetType="ToggleButton">
    <Setter Property="Background" Value="{DynamicResource Button.SecondaryBackground}" />
    <Setter Property="Foreground" Value="{DynamicResource SideBar.Foreground}" />
    <Setter Property="Padding" Value="14,7" />
    <Setter Property="FontSize" Value="12.5" />
    <Setter Property="Cursor" Value="Hand" />
    <Setter Property="Template">
      <Setter.Value>
        <ControlTemplate TargetType="ToggleButton">
          <Border x:Name="Face" Background="{TemplateBinding Background}"
                  CornerRadius="{StaticResource Radius.Control}"
                  Padding="{TemplateBinding Padding}" SnapsToDevicePixels="True">
            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
          </Border>
          <ControlTemplate.Triggers>
            <Trigger Property="IsChecked" Value="True">
              <Setter TargetName="Face" Property="Background"
                      Value="{DynamicResource Button.Background}" />
              <Setter Property="Foreground" Value="{DynamicResource Button.Foreground}" />
            </Trigger>
            <Trigger Property="IsMouseOver" Value="True">
              <Setter TargetName="Face" Property="Opacity" Value="0.9" />
            </Trigger>
          </ControlTemplate.Triggers>
        </ControlTemplate>
      </Setter.Value>
    </Setter>
  </Style>

  <!-- A face outlined on the open photograph. Green once somebody has said who
       it is, so a picture shows at a glance what is left to do. -->
  <Style x:Key="FaceBox" TargetType="Button">
    <Setter Property="Background" Value="Transparent" />
    <Setter Property="Cursor" Value="Hand" />
    <Setter Property="Template">
      <Setter.Value>
        <ControlTemplate TargetType="Button">
          <Border x:Name="Outline" BorderThickness="2" Background="Transparent"
                  BorderBrush="{DynamicResource Status.Caution}"
                  CornerRadius="{StaticResource Radius.Inner}" SnapsToDevicePixels="True">
            <ContentPresenter VerticalAlignment="Bottom" HorizontalAlignment="Center" />
          </Border>
          <ControlTemplate.Triggers>
            <DataTrigger Binding="{Binding IsNamed}" Value="True">
              <Setter TargetName="Outline" Property="BorderBrush"
                      Value="{DynamicResource Status.Success}" />
            </DataTrigger>
            <!-- Set aside: still outlined, so it can be brought back, but faded
                 out of the way of the faces that still need an answer. -->
            <DataTrigger Binding="{Binding IsIgnored}" Value="True">
              <Setter TargetName="Outline" Property="BorderBrush"
                      Value="{DynamicResource Neutral.6}" />
              <Setter TargetName="Outline" Property="Opacity" Value="0.45" />
            </DataTrigger>
            <Trigger Property="IsMouseOver" Value="True">
              <Setter TargetName="Outline" Property="BorderBrush"
                      Value="{DynamicResource Focus.Border}" />
            </Trigger>
          </ControlTemplate.Triggers>
        </ControlTemplate>
      </Setter.Value>
    </Setter>
  </Style>

  <Style x:Key="FaceBoxLabel" TargetType="Border">
    <Setter Property="Background" Value="#CC1E1E1E" />
    <Setter Property="Padding" Value="5,1" />
    <Setter Property="CornerRadius" Value="{StaticResource Radius.Inner}" />
    <Setter Property="Margin" Value="0,0,0,3" />
  </Style>

  <!-- People -->

  <!-- One question on the review list. A panel rather than a table row: it holds
       a grid of faces and the controls that answer it, which no row layout in
       this app is shaped for. -->
  <Style x:Key="PeopleCard" TargetType="Border">
    <Setter Property="Background" Value="{DynamicResource SideBar.Background}" />
    <Setter Property="BorderBrush" Value="{DynamicResource Panel.Border}" />
    <Setter Property="BorderThickness" Value="1" />
    <Setter Property="CornerRadius" Value="{StaticResource Radius.Control}" />
    <Setter Property="Padding" Value="14,12" />
    <Setter Property="Margin" Value="0,0,0,10" />
    <Setter Property="SnapsToDevicePixels" Value="True" />
  </Style>

  <Style x:Key="FaceCrop" TargetType="Image">
    <Setter Property="Width" Value="100" />
    <Setter Property="Height" Value="100" />
    <Setter Property="Stretch" Value="UniformToFill" />
    <Setter Property="Margin" Value="0,0,6,6" />
    <Setter Property="SnapsToDevicePixels" Value="True" />
  </Style>

  <!-- The way out of a crop and into the picture it came from. Drawn on the
       crop rather than beside it: the question is about that one face, and a
       row of buttons under a wall of faces belongs to none of them. -->
  <Style x:Key="CropAction" TargetType="Button">
    <Setter Property="Width" Value="22" />
    <Setter Property="Height" Value="22" />
    <Setter Property="Margin" Value="0,4,10,0" />
    <Setter Property="HorizontalAlignment" Value="Right" />
    <Setter Property="VerticalAlignment" Value="Top" />
    <Setter Property="Cursor" Value="Hand" />
    <Setter Property="Opacity" Value="0.6" />
    <Setter Property="FontFamily" Value="Segoe MDL2 Assets" />
    <Setter Property="FontSize" Value="11" />
    <Setter Property="Foreground" Value="White" />
    <Setter Property="Template">
      <Setter.Value>
        <ControlTemplate TargetType="Button">
          <Border Background="#CC1E1E1E" CornerRadius="11" SnapsToDevicePixels="True">
            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
          </Border>
        </ControlTemplate>
      </Setter.Value>
    </Setter>
    <Style.Triggers>
      <Trigger Property="IsMouseOver" Value="True">
        <Setter Property="Opacity" Value="1" />
      </Trigger>
    </Style.Triggers>
  </Style>

  <!-- The face being asked about, outlined on the whole picture. Not hit
       testable: the answer is given by the buttons, and a box that swallowed
       clicks would only be a way to miss them. -->
  <Style x:Key="ProposalOutline" TargetType="Border">
    <Setter Property="BorderThickness" Value="2" />
    <Setter Property="BorderBrush" Value="{DynamicResource Status.Caution}" />
    <Setter Property="CornerRadius" Value="{StaticResource Radius.Inner}" />
    <Setter Property="SnapsToDevicePixels" Value="True" />
    <Setter Property="IsHitTestVisible" Value="False" />
  </Style>

  <!-- A name in the "who is this?" list. The one already on the face is marked
       in the name itself as well as by the tick beside it: a tick in the far
       corner of a list of nine is easy to miss, and the thing being changed is
       the name. -->
  <Style x:Key="FaceChoiceName" TargetType="TextBlock">
    <Style.Triggers>
      <DataTrigger Binding="{Binding IsCurrent}" Value="True">
        <Setter Property="Foreground" Value="{DynamicResource Status.Success}" />
        <Setter Property="FontWeight" Value="SemiBold" />
      </DataTrigger>
    </Style.Triggers>
  </Style>

  <!-- A proposed face, which the user is answering yes or no to. Chosen is the
       default, so a whole screenful is confirmed with one click and the odd
       wrong one is switched off first. -->
  <Style x:Key="FaceChoice" TargetType="ToggleButton">
    <Setter Property="Background" Value="Transparent" />
    <Setter Property="BorderThickness" Value="0" />
    <Setter Property="Cursor" Value="Hand" />
    <Setter Property="Margin" Value="0,0,6,6" />
    <Setter Property="Template">
      <Setter.Value>
        <ControlTemplate TargetType="ToggleButton">
          <Border x:Name="Frame" Padding="3" CornerRadius="{StaticResource Radius.Control}"
                  Background="Transparent" BorderThickness="2" BorderBrush="Transparent"
                  SnapsToDevicePixels="True">
            <ContentPresenter />
          </Border>
          <ControlTemplate.Triggers>
            <Trigger Property="IsChecked" Value="True">
              <Setter TargetName="Frame" Property="BorderBrush"
                      Value="{DynamicResource Focus.Border}" />
            </Trigger>
            <Trigger Property="IsChecked" Value="False">
              <Setter TargetName="Frame" Property="Opacity" Value="0.35" />
            </Trigger>
            <Trigger Property="IsMouseOver" Value="True">
              <Setter TargetName="Frame" Property="Background"
                      Value="{DynamicResource List.HoverBackground}" />
            </Trigger>
          </ControlTemplate.Triggers>
        </ControlTemplate>
      </Setter.Value>
    </Setter>
  </Style>

  <!--
    What is known about one picture. One template for the photo viewer, the face
    review and the duplicate comparison, so the same photograph reads the same
    way whichever screen you reached it from.

    The file name opens Explorer on the original; the app only ever reads its own
    small copies, so this is the way to the real thing.
  -->
  <DataTemplate DataType="{x:Type shell:PhotoDetails}">
    <StackPanel>
      <TextBlock Style="{DynamicResource FieldLabel}" Text="File" />
      <Button Style="{DynamicResource LinkButton}" FontSize="13" HorizontalAlignment="Left"
              Content="{Binding FileName}" ToolTip="{Binding FullPath}"
              Command="{Binding ShowInExplorerCommand}" />
      <TextBlock Style="{DynamicResource HintText}" TextWrapping="Wrap"
                 Text="{Binding FolderPath}" />

      <TextBlock Style="{DynamicResource FieldLabel}" Margin="0,14,0,0" Text="Size" />
      <TextBlock Style="{DynamicResource HintText}" Text="{Binding ExactSize}" />

      <TextBlock Style="{DynamicResource FieldLabel}" Margin="0,14,0,0" Text="Resolution" />
      <TextBlock Style="{DynamicResource HintText}" Text="{Binding Resolution}" />

      <TextBlock Style="{DynamicResource FieldLabel}" Margin="0,14,0,0" Text="Taken" />
      <TextBlock Style="{DynamicResource HintText}" TextWrapping="Wrap" Text="{Binding When}" />

      <!-- Both file dates, plainly, and which of the three the app files this
           picture under. The order matters on this library: copying stamps the
           creation date with the day of the copy and leaves the modified date
           alone, so the created date is usually the later and usually the
           wrong one. -->
      <StackPanel Visibility="{Binding HasFileDates,
                               Converter={StaticResource BoolToVisibility}}">
        <TextBlock Style="{DynamicResource FieldLabel}" Margin="0,14,0,0" Text="File created" />
        <TextBlock Style="{DynamicResource HintText}" Text="{Binding Created}" />

        <TextBlock Style="{DynamicResource FieldLabel}" Margin="0,14,0,0" Text="File modified" />
        <TextBlock Style="{DynamicResource HintText}" Text="{Binding Modified}" />

        <!-- Only when the filing date is not the one on show above. Collapsed
             rather than blank, so the line takes no room when it has nothing to
             say. -->
        <TextBlock Style="{DynamicResource HintText}" TextWrapping="Wrap"
                   Text="{Binding FiledUnder}"
                   Visibility="{Binding FiledUnder,
                                Converter={StaticResource InverseNullToVisibility}}" />
      </StackPanel>

      <!-- Absent, not blank. Five photographs in six carry no GPS and never
           will, so a label with nothing under it would read as something the app
           failed at rather than something the camera never recorded. -->
      <StackPanel Visibility="{Binding PlaceName,
                               Converter={StaticResource InverseNullToVisibility}}">
        <TextBlock Style="{DynamicResource FieldLabel}" Margin="0,14,0,0" Text="Place" />
        <TextBlock Style="{DynamicResource HintText}" TextWrapping="Wrap"
                   Text="{Binding PlaceName}" />
      </StackPanel>

      <TextBlock Style="{DynamicResource FieldLabel}" Margin="0,14,0,0"
                 Text="Fingerprint (SHA-256)" />
      <TextBlock Style="{DynamicResource HintText}" TextWrapping="Wrap"
                 FontFamily="{StaticResource Font.Mono}" FontSize="11"
                 Text="{Binding Fingerprint}" />
    </StackPanel>
  </DataTemplate>

  <!--
    Saying who a face is. One template, wherever the question is asked: over a
    photograph in the viewer, and over the picture being reviewed on the People
    screen. The wording and whether "nobody" is on offer come from the picker
    itself, so the two screens cannot drift apart.
  -->
  <DataTemplate DataType="{x:Type people:PersonPicker}">
    <Border MaxWidth="320" HorizontalAlignment="Center" VerticalAlignment="Center"
            Background="{DynamicResource SideBar.Background}"
            BorderBrush="{DynamicResource Panel.Border}" BorderThickness="1"
            CornerRadius="{StaticResource Radius.Control}" Padding="16,14">
      <StackPanel>
        <TextBlock Style="{DynamicResource FieldLabel}" Text="{Binding Prompt}" />
        <TextBlock Style="{DynamicResource HintText}" Margin="0,2,0,10"
                   TextWrapping="Wrap" Text="{Binding Hint}" />

        <!-- Scrolls rather than growing without limit: the panel is centred on
             the picture, and a list of thirty names would otherwise run off
             both ends of the window. -->
        <ScrollViewer MaxHeight="300" VerticalScrollBarVisibility="Auto"
                      HorizontalScrollBarVisibility="Disabled">
          <ItemsControl ItemsSource="{Binding Choices}">
            <ItemsControl.ItemTemplate>
              <DataTemplate>
                <Button Style="{DynamicResource SearchResult}" Padding="10,6"
                        Command="{Binding DataContext.ChooseCommand,
                                  RelativeSource={RelativeSource AncestorType=ItemsControl}}"
                        CommandParameter="{Binding}">
                  <Grid>
                    <!-- The name already on this face, so changing it is a
                         change the user can see they are making. -->
                    <TextBlock Text="{Binding DisplayName}" HorizontalAlignment="Left"
                               Style="{DynamicResource FaceChoiceName}" />
                    <TextBlock Text="&#xE73E;" FontFamily="Segoe MDL2 Assets"
                               FontSize="11" HorizontalAlignment="Right"
                               Foreground="{DynamicResource Status.Success}"
                               Visibility="{Binding IsCurrent,
                                            Converter={StaticResource BoolToVisibility}}" />
                  </Grid>
                </Button>
              </DataTemplate>
            </ItemsControl.ItemTemplate>
          </ItemsControl>
        </ScrollViewer>

        <TextBlock Style="{DynamicResource HintText}" Margin="0,8,0,4"
                   Text="Type to narrow the list, or to add somebody new" />
        <Grid>
          <Grid.ColumnDefinitions>
            <ColumnDefinition Width="*" />
            <ColumnDefinition Width="Auto" />
          </Grid.ColumnDefinitions>
          <TextBox Grid.Column="0" Style="{DynamicResource InputTextBox}"
                   AutomationProperties.Name="Find or add a person"
                   Text="{Binding Typed, UpdateSourceTrigger=PropertyChanged}">
            <TextBox.InputBindings>
              <KeyBinding Key="Return" Command="{Binding AddCommand}" />
            </TextBox.InputBindings>
          </TextBox>
          <Button Grid.Column="1" Style="{DynamicResource SecondaryButton}"
                  Margin="8,0,0,0" MinWidth="60" Content="Add"
                  Command="{Binding AddCommand}" />
        </Grid>

        <TextBlock Style="{DynamicResource HintText}" Margin="0,6,0,0" TextWrapping="Wrap"
                   Text="Nobody by that name yet. Add makes them."
                   Visibility="{Binding HasNoMatch,
                                Converter={StaticResource BoolToVisibility}}" />

        <!-- Strangers in the background outnumber the people a library is
             about, and refusing them one person at a time never ends. Offered
             only where the screen has somewhere to put such a face. -->
        <Button Style="{DynamicResource SecondaryButton}" Margin="0,12,0,0"
                HorizontalAlignment="Stretch" Content="{Binding SetAsideLabel}"
                ToolTip="Set this face aside. Naming it later brings it back."
                Command="{Binding SetAsideCommand}"
                Visibility="{Binding CanSetAside,
                             Converter={StaticResource BoolToVisibility}}" />

        <Button Style="{DynamicResource LinkButton}" Margin="0,10,0,0"
                HorizontalAlignment="Left" Content="Cancel"
                Command="{Binding CancelCommand}" />
      </StackPanel>
    </Border>
  </DataTemplate>

</ResourceDictionary>
