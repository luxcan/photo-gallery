<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

  <!-- Apple-style, dark. macOS neutrals on a near-black page with the system
       blue as the accent, from the design handoff "PhotoGallery - Apple-style
       theme"; the hexes its token table names are that file's, unchanged, so a
       colour can be traced back to its source.

       Two vocabularies, one set of colours. The handoff's own key names come
       first and are the definitions - anything new should use them, because they
       are the ones the specification is written against. Below them the names
       this app already used are mapped onto the same colours, which is what lets
       the whole shell change appearance without a line of MainWindow.xaml or
       Controls.xaml moving. Where the two disagree the mapping is the honest
       record of which role a screen actually wanted.

       Light.xaml defines exactly these keys; nothing may be defined in only one
       of the two. -->

  <!-- ===== Palette tokens ===== -->
  <Color x:Key="AppBackgroundColor">#FF141414</Color>
  <Color x:Key="SurfaceBackgroundColor">#FF1E1E1E</Color>
  <Color x:Key="SurfaceAltBackgroundColor">#FF2A2A2C</Color>
  <Color x:Key="TitleBarBackgroundColor">#FF2A2A2C</Color>
  <Color x:Key="StatusBarBackgroundColor">#FF2A2A2C</Color>
  <Color x:Key="StatusBarForegroundColor">#FF98989D</Color>
  <Color x:Key="ControlBackgroundColor">#FF323234</Color>
  <Color x:Key="ControlBackgroundHoverColor">#FF3A3A3C</Color>
  <Color x:Key="ControlBackgroundPressedColor">#FF48484A</Color>
  <Color x:Key="ControlBackgroundDisabledColor">#FF262628</Color>
  <Color x:Key="ControlBorderColor">#FF48484A</Color>
  <Color x:Key="ControlBorderHoverColor">#FF636366</Color>
  <Color x:Key="ControlBorderDisabledColor">#FF2C2C2E</Color>
  <Color x:Key="DividerColor">#FF3A3A3C</Color>
  <Color x:Key="TextPrimaryColor">#FFF5F5F7</Color>
  <Color x:Key="TextSecondaryColor">#FFD1D1D6</Color>

  <!-- The fourth text grey, as in Light.xaml. Here it is one step brighter than
       the disabled grey rather than equal to it, which is what the handoff's
       dark table asks for: a watermark has to be readable, a section that cannot
       be opened does not. -->
  <!-- The caption grey. The handoff separates it from the placeholder by eight
       units - captions and hints at #FF98989D, watermarks and counts one step
       darker - which is invisible side by side and is still what the table
       says, so it is carried rather than rounded away. -->
  <Color x:Key="TextCaptionColor">#FF98989D</Color>
  <Color x:Key="TextPlaceholderColor">#FF98989D</Color>
  <Color x:Key="TextDisabledColor">#FF8E8E93</Color>

  <Color x:Key="AccentBackgroundColor">#FF0A84FF</Color>
  <!-- The one value taken FROM the handoff rather than from it. The table asks
       for #409CFF, which is lighter than the accent it hovers off, so white on
       it measures 2.83:1 against 3.65:1 at rest - the label gets harder to read
       at the moment the pointer arrives, and the pressed state below is darker
       again, so the ladder turned back on itself half way.

       This is the handoff's own light step applied to the dark accent: light
       goes #007AFF to #0071E3, which darkens green by 0.93 and blue by 0.89,
       and the same two factors on #0A84FF give this. White on it is 4.28:1, and
       rest 3.65 to hover 4.28 to pressed 5.59 now climbs the whole way. Raised
       with whoever wrote the table rather than settled here. -->
  <Color x:Key="AccentBackgroundHoverColor">#FF097AE3</Color>
  <Color x:Key="AccentBackgroundPressedColor">#FF0064D2</Color>
  <Color x:Key="AccentForegroundColor">#FFFFFFFF</Color>
  <Color x:Key="FocusVisualColor">#660A84FF</Color>
  <Color x:Key="SelectionBackgroundColor">#FF1A3450</Color>
  <Color x:Key="SelectionBackgroundHoverColor">#FF193959</Color>
  <Color x:Key="SelectionUnfocusedColor">#FF3A3A3C</Color>
  <Color x:Key="RowAlternatingColor">#FF242426</Color>
  <Color x:Key="ScrollBarTrackColor">#FF2A2A2C</Color>
  <Color x:Key="ScrollBarThumbColor">#FF48484A</Color>
  <Color x:Key="ScrollBarThumbHoverColor">#FF636366</Color>
  <Color x:Key="TooltipBackgroundColor">#FF3A3A3C</Color>
  <Color x:Key="TooltipForegroundColor">#FFF5F5F7</Color>
  <Color x:Key="TooltipBorderColor">#FF48484A</Color>
  <Color x:Key="ValidationErrorColor">#FFFF453A</Color>
  <Color x:Key="ValidationErrorRingColor">#40FF453A</Color>

  <SolidColorBrush x:Key="AppBackground"             Color="{StaticResource AppBackgroundColor}" />
  <SolidColorBrush x:Key="SurfaceBackground"         Color="{StaticResource SurfaceBackgroundColor}" />
  <SolidColorBrush x:Key="SurfaceAltBackground"      Color="{StaticResource SurfaceAltBackgroundColor}" />
  <SolidColorBrush x:Key="TitleBarBackground"        Color="{StaticResource TitleBarBackgroundColor}" />
  <SolidColorBrush x:Key="StatusBarBackground"       Color="{StaticResource StatusBarBackgroundColor}" />
  <SolidColorBrush x:Key="StatusBarForeground"       Color="{StaticResource StatusBarForegroundColor}" />
  <SolidColorBrush x:Key="ControlBackground"         Color="{StaticResource ControlBackgroundColor}" />
  <SolidColorBrush x:Key="ControlBackgroundHover"    Color="{StaticResource ControlBackgroundHoverColor}" />
  <SolidColorBrush x:Key="ControlBackgroundPressed"  Color="{StaticResource ControlBackgroundPressedColor}" />
  <SolidColorBrush x:Key="ControlBackgroundDisabled" Color="{StaticResource ControlBackgroundDisabledColor}" />
  <SolidColorBrush x:Key="ControlBorder"             Color="{StaticResource ControlBorderColor}" />
  <SolidColorBrush x:Key="ControlBorderHover"        Color="{StaticResource ControlBorderHoverColor}" />
  <SolidColorBrush x:Key="ControlBorderDisabled"     Color="{StaticResource ControlBorderDisabledColor}" />
  <SolidColorBrush x:Key="Divider"                   Color="{StaticResource DividerColor}" />
  <SolidColorBrush x:Key="TextPrimary"               Color="{StaticResource TextPrimaryColor}" />
  <SolidColorBrush x:Key="TextSecondary"             Color="{StaticResource TextSecondaryColor}" />
  <SolidColorBrush x:Key="TextCaption"               Color="{StaticResource TextCaptionColor}" />
  <SolidColorBrush x:Key="TextPlaceholder"           Color="{StaticResource TextPlaceholderColor}" />
  <SolidColorBrush x:Key="TextDisabled"              Color="{StaticResource TextDisabledColor}" />
  <SolidColorBrush x:Key="AccentBackground"          Color="{StaticResource AccentBackgroundColor}" />
  <SolidColorBrush x:Key="AccentBackgroundHover"     Color="{StaticResource AccentBackgroundHoverColor}" />
  <SolidColorBrush x:Key="AccentBackgroundPressed"   Color="{StaticResource AccentBackgroundPressedColor}" />
  <SolidColorBrush x:Key="AccentForeground"          Color="{StaticResource AccentForegroundColor}" />
  <SolidColorBrush x:Key="FocusVisual"               Color="{StaticResource FocusVisualColor}" />
  <SolidColorBrush x:Key="SelectionBackground"       Color="{StaticResource SelectionBackgroundColor}" />
  <SolidColorBrush x:Key="SelectionBackgroundHover"  Color="{StaticResource SelectionBackgroundHoverColor}" />
  <SolidColorBrush x:Key="SelectionUnfocused"        Color="{StaticResource SelectionUnfocusedColor}" />
  <SolidColorBrush x:Key="RowAlternating"            Color="{StaticResource RowAlternatingColor}" />
  <SolidColorBrush x:Key="ScrollBarTrack"            Color="{StaticResource ScrollBarTrackColor}" />
  <SolidColorBrush x:Key="ScrollBarThumb"            Color="{StaticResource ScrollBarThumbColor}" />
  <SolidColorBrush x:Key="ScrollBarThumbHover"       Color="{StaticResource ScrollBarThumbHoverColor}" />
  <SolidColorBrush x:Key="TooltipBackground"         Color="{StaticResource TooltipBackgroundColor}" />
  <SolidColorBrush x:Key="TooltipForeground"         Color="{StaticResource TooltipForegroundColor}" />
  <SolidColorBrush x:Key="TooltipBorder"             Color="{StaticResource TooltipBorderColor}" />
  <SolidColorBrush x:Key="ValidationError"           Color="{StaticResource ValidationErrorColor}" />
  <SolidColorBrush x:Key="ValidationErrorRing"       Color="{StaticResource ValidationErrorRingColor}" />

  <!-- ===== This app's names, mapped onto those roles ===== -->

  <Color x:Key="Color.Accent">#FF0A84FF</Color>

  <SolidColorBrush x:Key="TitleBar.Background"        Color="{StaticResource TitleBarBackgroundColor}" />
  <SolidColorBrush x:Key="TitleBar.Foreground"        Color="{StaticResource TextPrimaryColor}" />

  <!-- The side nav is recessed chrome, so it takes the alternate surface rather
       than a shade of its own. Its foreground is the PRIMARY text colour, not a
       secondary one: the handoff draws an unselected section at full strength
       and says which one is open by filling its row with the accent instead of
       by dimming the others. SideNav.ActiveBorder no longer paints anything -
       the 2 DIP rail it fed went with the rest of that idea - and it is kept
       only so the two files stay key for key. -->
  <SolidColorBrush x:Key="SideNav.Background"       Color="{StaticResource SurfaceAltBackgroundColor}" />
  <SolidColorBrush x:Key="SideNav.Foreground"       Color="{StaticResource TextPrimaryColor}" />
  <SolidColorBrush x:Key="SideNav.ActiveForeground" Color="{StaticResource TextPrimaryColor}" />
  <SolidColorBrush x:Key="SideNav.ActiveBorder"     Color="{StaticResource AccentBackgroundColor}" />

  <!-- The count on the open row, which is white text on the accent and has to
       sit back from the name beside it. Eight tenths of white rather than a grey
       mixed against the blue, so it holds whatever the accent turns out to be. -->
  <SolidColorBrush x:Key="SideNav.SelectedCount"    Color="#CCFFFFFF" />

  <!-- The three rows at the foot of the nav, a step back from the sections
       above them. Its own key rather than SideBar.Foreground: that one is also
       the label on every SecondaryButton, and the artboards draw those at full
       strength while drawing the foot nav quieter. One key cannot be both. -->
  <SolidColorBrush x:Key="SideNav.FootForeground"   Color="{StaticResource TextSecondaryColor}" />

  <SolidColorBrush x:Key="SideBar.Background"         Color="{StaticResource SurfaceAltBackgroundColor}" />
  <SolidColorBrush x:Key="SideBar.Foreground"         Color="{StaticResource TextPrimaryColor}" />
  <SolidColorBrush x:Key="SideBar.SectionHeader"      Color="{StaticResource TextSecondaryColor}" />

  <SolidColorBrush x:Key="Editor.Background"          Color="{StaticResource SurfaceBackgroundColor}" />
  <SolidColorBrush x:Key="Editor.Foreground"          Color="{StaticResource TextPrimaryColor}" />

  <!-- Its own rung now. This key does not only dress watermarks: it also carries
       the picture count, the folder path under a face and what the search
       understood, so it may not fall to the disabled grey. -->
  <SolidColorBrush x:Key="Editor.Placeholder"         Color="{StaticResource TextPlaceholderColor}" />

  <SolidColorBrush x:Key="Panel.Background"           Color="{StaticResource SurfaceBackgroundColor}" />

  <!-- The divider, not the control border. The handoff separates the two: a card
       or a panel is outlined in the same hairline that rules a band off from
       what is under it, and only something you can type in or press carries the
       heavier ControlBorder. They were one colour under Precision, which is why
       they had been one token. -->
  <SolidColorBrush x:Key="Panel.Border"               Color="{StaticResource DividerColor}" />

  <SolidColorBrush x:Key="StatusBar.Background"       Color="{StaticResource StatusBarBackgroundColor}" />
  <SolidColorBrush x:Key="StatusBar.Foreground"       Color="{StaticResource StatusBarForegroundColor}" />
  <SolidColorBrush x:Key="StatusBar.HoverBackground"  Color="{StaticResource ControlBackgroundHoverColor}" />

  <SolidColorBrush x:Key="List.HoverBackground"       Color="{StaticResource ControlBackgroundHoverColor}" />
  <SolidColorBrush x:Key="List.ActiveSelection"       Color="{StaticResource SelectionBackgroundColor}" />
  <SolidColorBrush x:Key="List.ActiveSelectionText"   Color="{StaticResource TextPrimaryColor}" />

  <SolidColorBrush x:Key="Button.Background"          Color="{StaticResource AccentBackgroundColor}" />
  <SolidColorBrush x:Key="Button.HoverBackground"     Color="{StaticResource AccentBackgroundHoverColor}" />
  <SolidColorBrush x:Key="Button.PressedBackground"   Color="{StaticResource AccentBackgroundPressedColor}" />
  <SolidColorBrush x:Key="Button.Foreground"          Color="{StaticResource AccentForegroundColor}" />
  <SolidColorBrush x:Key="Button.SecondaryBackground" Color="{StaticResource ControlBackgroundColor}" />
  <SolidColorBrush x:Key="Button.SecondaryHover"      Color="{StaticResource ControlBackgroundHoverColor}" />
  <SolidColorBrush x:Key="Button.SecondaryPressedBackground" Color="{StaticResource ControlBackgroundPressedColor}" />

  <SolidColorBrush x:Key="Input.Background"           Color="{StaticResource ControlBackgroundColor}" />
  <SolidColorBrush x:Key="Input.Foreground"           Color="{StaticResource TextPrimaryColor}" />
  <SolidColorBrush x:Key="Input.Border"               Color="{StaticResource ControlBorderColor}" />

  <SolidColorBrush x:Key="Focus.Border"               Color="{StaticResource AccentBackgroundColor}" />
  <SolidColorBrush x:Key="Separator"                  Color="{StaticResource DividerColor}" />
  <SolidColorBrush x:Key="Link.Foreground"            Color="{StaticResource AccentBackgroundColor}" />

  <SolidColorBrush x:Key="Badge.Background"           Color="{StaticResource ControlBackgroundPressedColor}" />
  <SolidColorBrush x:Key="Badge.Foreground"           Color="{StaticResource TextPrimaryColor}" />

  <!-- The badge on a video tile is not the badge on a card. It is read against a
       photograph rather than against the page, so it is a dark scrim carrying
       white in BOTH themes - the one pair here whose light and dark values say
       the same thing. Badge.Background would put a pale chip on a pale picture
       and lose it. -->
  <SolidColorBrush x:Key="VideoBadge.Background"      Color="#B3000000" />
  <SolidColorBrush x:Key="VideoBadge.Foreground"      Color="#FFF5F5F7" />

  <SolidColorBrush x:Key="Log.Muted"                  Color="{StaticResource TextSecondaryColor}" />
  <SolidColorBrush x:Key="Log.Success"                Color="#FF30D158" />
  <SolidColorBrush x:Key="Log.Warning"                Color="#FFFF9F0A" />

  <!-- Numbered neutral ramp. Neutral.N here mirrors Neutral.N in Light.xaml:
       1 is the surface content sits on and 6 the strongest chrome, so a pairing
       with enough contrast at one number has it at that number in either theme.
       The luminance runs the other way here, which is the point - what matches
       across the two is the step, not the shade. -->
  <SolidColorBrush x:Key="Neutral.1" Color="{StaticResource SurfaceBackgroundColor}" />
  <SolidColorBrush x:Key="Neutral.2" Color="{StaticResource SurfaceAltBackgroundColor}" />
  <SolidColorBrush x:Key="Neutral.3" Color="{StaticResource ControlBackgroundColor}" />
  <SolidColorBrush x:Key="Neutral.4" Color="{StaticResource ControlBackgroundHoverColor}" />
  <SolidColorBrush x:Key="Neutral.5" Color="{StaticResource ControlBackgroundPressedColor}" />
  <SolidColorBrush x:Key="Neutral.6" Color="{StaticResource ControlBorderHoverColor}" />

  <!-- Status colours.

       Info and Danger are the theme's own: info is the accent, and danger is
       ValidationError, so an invalid field and a failure message say the same
       thing in the same colour.

       Success and Caution carry the handoff's values here and need no second
       strength: #30D158 and #FF9F0A measure 8.25:1 and 8.11:1 against this
       page, so the colour that outlines a face on a photograph is also the one
       a sentence can be written in. Light.xaml has to split them, and the vivid
       keys exist for its sake; here both strengths are the same colour, which
       is the honest way to say the split does not apply. -->
  <SolidColorBrush x:Key="Status.Info"         Color="{StaticResource AccentBackgroundColor}" />
  <SolidColorBrush x:Key="Status.InfoBack"     Color="{StaticResource SelectionBackgroundColor}" />
  <SolidColorBrush x:Key="Status.Success"      Color="#FF30D158" />
  <SolidColorBrush x:Key="Status.SuccessVivid" Color="#FF30D158" />
  <SolidColorBrush x:Key="Status.SuccessBack"  Color="#FF22452B" />
  <SolidColorBrush x:Key="Status.Caution"      Color="#FFFF9F0A" />
  <SolidColorBrush x:Key="Status.CautionVivid" Color="#FFFF9F0A" />
  <SolidColorBrush x:Key="Status.CautionBack"  Color="#FF503A1A" />
  <SolidColorBrush x:Key="Status.Danger"       Color="{StaticResource ValidationErrorColor}" />
  <SolidColorBrush x:Key="Status.DangerBack"   Color="#FF502724" />

</ResourceDictionary>
